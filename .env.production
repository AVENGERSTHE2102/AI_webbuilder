# Production Environment Variables for Render

# Backend - API Key (choose one)
# Option 1: OpenRouter (Recommended)
OPENROUTER_API_KEY=  # Set this in Render Dashboard

# Option 2: Direct Anthropic
# ANTHROPIC_API_KEY=  # Set this in Render Dashboard

# Server Config
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Frontend (set via Render environment variables)
# VITE_API_URL will be automatically set by Render Blueprint
