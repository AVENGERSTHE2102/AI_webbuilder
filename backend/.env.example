# Zero-Code AI App Builder Configuration

# API Keys (choose one)
# Option 1: OpenRouter API (Recommended - more flexible)
OPENROUTER_API_KEY=your_openrouter_key_here

# Option 2: Direct Anthropic API
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Note: If both are set, OpenRouter will be used

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Development Mode
DEBUG=true
